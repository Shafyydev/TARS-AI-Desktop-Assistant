# TARS Environment Configuration

# Primary LLM API Key (Google Gemini is recommended for fast multi-modal reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional dedicated Porcupine wake-word engine. Create/download a custom
# Windows .ppn model for "TARS" in the Picovoice Console.
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here
TARS_WAKE_KEYWORD_PATH=C:\path\to\tars_windows.ppn

# Optional: Default voice speed and pitch
TARS_VOICE=en-US-GuyNeural
TARS_VOICE_RATE=+0%
TARS_VOICE_PITCH=+0Hz

# Execution Mode: text | voice | hybrid
TARS_DEFAULT_MODE=hybrid
